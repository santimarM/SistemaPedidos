@startuml
left to right direction
skinparam packageStyle rectangle

actor "Usuario de mostrador" as Usuario

rectangle "Sistema de Pedidos" {
  usecase "CU4 - Cancelar Pedido" as UC4
  usecase "Seleccionar pedido" as UC4a
  usecase "Verificar estado del pedido" as UC4b
  usecase "Cambiar estado a Cancelado" as UC4c
  usecase "Registrar cancelación en auditoría" as UC4d
  usecase "Notificar a cocina" as UC4e
}

Usuario --> UC4
UC4 .> UC4a : <<include>>
UC4 .> UC4b : <<include>>
UC4 .> UC4c : <<include>>
UC4 .> UC4d : <<include>>
UC4 .> UC4e : <<include>>

note right of UC4b
  Solo se puede cancelar si el pedido
  está en RECIBIDO o EN_PREPARACION.
  Si está LISTO, no se permite cancelar.
end note
@enduml